{
  "name": "clisanguo",
  "version": "1.0.0",
  "description": "CLI SanGuo card game powered by OpenTUI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run src/index.ts",
    "host": "tsx src/network/host.ts",
    "join": "tsx src/network/client.ts",
    "webui": "tsx src/webui/relay.ts",
    "webui:build": "cd webui && npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "node --test --import tsx \"src/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@opentui/core": "^0.1.96",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.39.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
