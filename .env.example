# ============================================================
# CLI 三国杀 环境变量示例
# 用法：复制为 .env（已被 gitignore）后改成你本机的值：
#   cp .env.example .env
# 说明：本文件是代码实际读取的变量名，勿臆造其他名字。
# ============================================================

# ---------- 云端 LLM（Qwen 适配器走 OpenAI 兼容 /chat/completions） ----------
# STEP_PLAN_API_KEY：AI 决策接口密钥（必填，替换为你的真实 Key）
STEP_PLAN_API_KEY=your_step_plan_api_key

# STEP_PLAN_BASE_URL：OpenAI 兼容接口地址（默认 https://api.stepfun.com/step_plan/v1）
STEP_PLAN_BASE_URL=https://api.stepfun.com/step_plan/v1

# STEP_PLAN_MODEL：默认模型名称
STEP_PLAN_MODEL=step-3.7-flash

# ---------- 本地 LLM（Ollama） ----------
# OLLAMA_BASE_URL：本地 Ollama 服务地址（IDE/容器场景推荐 127.0.0.1）
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OLLAMA_MODEL：Ollama 默认模型名称
OLLAMA_MODEL=gemma4:latest

# ---------- 联机（npm run host） ----------
# 联机模式默认端口（host.ts 也可通过 --port 指定；本项目端口以 --port 为准）
SG_ONLINE_PORT=9527

# 联机 AI 可配置项（也可用 host 启动参数覆盖，见 README）
# SG_AI_CONTEXT_ROUNDS=30      # AI 提示词保留的最近回合数（适配长上下文模型）
# SG_AI_THINKING_MS=1200       # 每回合思考时间基数（毫秒），按推理等级乘以系数

# ---------- Hybrid 快慢结合（LLM 决策 + Jev 判断） ----------
# SG_AI_HYBRID=true            # 默认开启。true=LLM 出牌后用 Jev 判断层审核（noul 概率否决乱打，
#                              #   否决时回退 Jev 的 choice 最优动作）；未配置 JEV_* 时自动退回纯 LLM。
#                              # false=纯 LLM，不调用 Jev。
# 等价启动参数：--ai-driver=hybrid（= qwen 慢思考 + Jev 判断）/ --hybrid=false 关闭
# 仅对 qwen / ollama 驱动生效；simple / system-one 本来就是纯本地策略，不受此项影响。

# ---------- System-One 本地快思考 AI 配置 ----------
# 说明：System-One 是内置的本地打分 AI（无需网络/模型），仅用于独立驱动
#       `--ai-driver=system-one`。Hybrid 判断层已改为 LLM + Jev，不再走本地决策模型。
# SG_SYSTEM_ONE_MAX_MEMORY=60  # 短期事件记忆上限（用于身份推断/近期攻防统计），默认 60
# SG_SYSTEM_ONE_JUDGE_GAP=3    # 本地 Judge 门控容忍分差，默认 3（仅 system-one 驱动生效）。

# ---------- Jev 判断模型 API（TypeSafe System One，替代本地判断层） ----------
# 说明：Jev 不是 chat 模型，不走 OpenAI /chat/completions；它是结构化决策接口
#       POST {JEV_BASE_URL}/systemone，传入 state + questions，返回 answers（choice/noul/score）。
#       Hybrid 模式下判断层默认用本地 System-One 启发式；一旦配置了下面任一项，
#       判断层改为调用 Jev，用 noul 概率决定是否放行 LLM 的决策；调用失败自动回退本地，不中断对局。
#       默认全部注释；要用 Jev 时取消注释并填好密钥即可。
#
# JEV_API_KEY：TypeSafe 密钥（也可用官方 SDK 惯例名 TYPESAFE_API_KEY）
# JEV_BASE_URL：API 基址，默认 https://api.typesafe.ai/v1（端点自动拼 /systemone）
# JEV_MODEL：模型名，默认 jev-latest
# JEV_ACCEPT_THRESHOLD：noul 判断的接受阈值（0~1），默认 0.5；调高=更严格地否决 LLM
# JEV_MAX_CANDIDATES：choice 问题里最多列多少个候选动作（上限 255），默认 40
# JEV_TIMEOUT_MS：单次判断请求超时（毫秒），默认 15000
#
# JEV_API_KEY=your_typesafe_api_key
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-latest
# JEV_ACCEPT_THRESHOLD=0.5
# JEV_MAX_CANDIDATES=40
# JEV_TIMEOUT_MS=15000
