# QWEN_API_KEY：Qwen 接口密钥（必填，替换为你的真实 Key）
QWEN_API_KEY=your_qwen_api_key

# QWEN_BASE_URL：Qwen 兼容接口地址（一般保持默认）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# QWEN_MODEL：Qwen 默认模型名称
QWEN_MODEL=qwen-plus

# OLLAMA_BASE_URL：本地 Ollama 服务地址（IDE/容器场景推荐 127.0.0.1）
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OLLAMA_MODEL：Ollama 默认模型名称
OLLAMA_MODEL=gemma4:latest

# 联机模式默认端口（也可通过 --port 指定）
SG_ONLINE_PORT=9527
