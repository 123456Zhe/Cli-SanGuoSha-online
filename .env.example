# STEP_PLAN_API_KEY：AI 决策接口密钥（必填，替换为你的真实 Key）
# qwen 适配器（OpenAI 兼容 /chat/completions）实际读取的环境变量名
STEP_PLAN_API_KEY=your_step_plan_api_key

# STEP_PLAN_BASE_URL：OpenAI 兼容接口地址（默认 https://api.stepfun.com/step_plan/v1）
STEP_PLAN_BASE_URL=https://api.stepfun.com/step_plan/v1

# STEP_PLAN_MODEL：默认模型名称
STEP_PLAN_MODEL=step-3.7-flash

# OLLAMA_BASE_URL：本地 Ollama 服务地址（IDE/容器场景推荐 127.0.0.1）
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OLLAMA_MODEL：Ollama 默认模型名称
OLLAMA_MODEL=gemma4:latest

# 联机模式默认端口（host.ts 也可通过 --port 指定）
SG_ONLINE_PORT=9527

# 联机 AI 可配置项（也可用 host 启动参数覆盖，见 README）
# SG_AI_CONTEXT_ROUNDS=30      # AI 提示词保留的最近回合数（适配长上下文模型）
# SG_AI_THINKING_MS=1200       # 每回合思考时间基数（毫秒），按推理等级乘以系数
